<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<interface>
  <requires lib="gtk" version="4.24"/>
  <requires lib="libadwaita" version="1.10"/>
  <object class="AdwShortcutsDialog" id="shortcuts_dialog">
    <child>
      <object class="AdwShortcutsSection">
        <property name="title" translatable="yes">General</property>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Preferences</property>
            <property name="action-name">app.preferences</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Keyboard Shortcuts</property>
            <property name="action-name">app.shortcuts</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Help</property>
            <property name="action-name">app.help</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Main Menu</property>
            <property name="accelerator">F10</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Close Window</property>
            <property name="action-name">window.close</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Quit</property>
            <property name="action-name">app.quit</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwShortcutsSection">
        <property name="title" translatable="yes">Timelines</property>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">New Post</property>
            <property name="action-name">win.compose</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Reload</property>
            <property name="action-name">win.reload</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Toggle Sidebar</property>
            <property name="action-name">win.toggle-sidebar</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Go Back</property>
            <property name="accelerator">&lt;Alt&gt;Left</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Search</property>
            <property name="accelerator">&lt;primary&gt;f &lt;primary&gt;k</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Go to Home</property>
            <property name="accelerator">&lt;primary&gt;1 &lt;alt&gt;Home</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Go to Notifications</property>
            <property name="accelerator">&lt;primary&gt;2 &lt;primary&gt;&lt;shift&gt;n</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Go to Conversations</property>
            <property name="action-name">win.goto-place('conversations')</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Go to Search</property>
            <property name="action-name">win.goto-place('search')</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Go to Favorites</property>
            <property name="action-name">win.goto-place('favourites')</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Go to Bookmarks</property>
            <property name="action-name">win.goto-place('bookmarks')</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Go to Hashtags</property>
            <property name="action-name">win.goto-place('hashtags')</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Go to Explore</property>
            <property name="action-name">win.goto-place('explore')</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Go to Local</property>
            <property name="action-name">win.goto-place('local')</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Scroll Page Down</property>
            <property name="accelerator">Page_Down</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Scroll Page Up</property>
            <property name="accelerator">Page_Up</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Increase Text Size</property>
            <property name="accelerator">&lt;primary&gt;plus &lt;primary&gt;equal &lt;primary&gt;KP_Add</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Decrease Text Size</property>
            <property name="accelerator">&lt;primary&gt;minus &lt;primary&gt;KP_Subtract</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Reset Text Size</property>
            <property name="accelerator">&lt;primary&gt;0 &lt;primary&gt;KP_0</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwShortcutsSection">
        <property name="title" translatable="yes">Catch Up</property>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Next Post</property>
            <property name="accelerator">j</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Previous Post</property>
            <property name="accelerator">k</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Next Author</property>
            <property name="accelerator">l</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Previous Author</property>
            <property name="accelerator">h</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Open Post</property>
            <property name="accelerator">Return</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Scroll to Top</property>
            <property name="accelerator">period</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwShortcutsSection">
        <property name="title" translatable="yes">Web Column</property>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Hide Web Column</property>
            <property name="accelerator">Escape &lt;primary&gt;w</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Back</property>
            <property name="accelerator">&lt;Alt&gt;Left</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Forward</property>
            <property name="accelerator">&lt;Alt&gt;Right</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Reload Page</property>
            <property name="accelerator">&lt;primary&gt;r F5</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwShortcutsSection">
        <property name="title" translatable="yes">Composer</property>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Send Post</property>
            <property name="accelerator">&lt;primary&gt;Return</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Close Composer</property>
            <property name="accelerator">Escape</property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
