#!@PYTHON@

# SPDX-License-Identifier: GPL-3.0-or-later

import os
import sys
import signal
import locale
import gettext

VERSION = '@VERSION@'
pkgdatadir = '@pkgdatadir@'
localedir = '@localedir@'

# Prefer the installed data directory; fall back to the build tree so an
# uninstalled run works. The modules are a package named `babble`, so the
# build-tree case binds that name to the source directory directly.
if os.path.isdir(pkgdatadir):
    sys.path.insert(1, pkgdatadir)
else:
    import importlib.util
    _srcdir = os.path.normpath(os.path.join(
        os.path.dirname(os.path.abspath(__file__)), '..', '..', 'src'))
    _spec = importlib.util.spec_from_file_location(
        'babble', os.path.join(_srcdir, '__init__.py'),
        submodule_search_locations=[_srcdir])
    _pkg = importlib.util.module_from_spec(_spec)
    sys.modules['babble'] = _pkg
    _spec.loader.exec_module(_pkg)
signal.signal(signal.SIGINT, signal.SIG_DFL)
locale.bindtextdomain('babble', localedir)
locale.textdomain('babble')
gettext.bindtextdomain('babble', localedir)
gettext.textdomain('babble')


def use_time_locale(language):
    """Month names and date formats follow LC_TIME, not LANGUAGE:
    point it at a locale for *language* when one is installed. A missing
    one is left alone, since GTK's setlocale(LC_ALL, "") would then fail
    for every category, translations included."""
    if os.environ.get('LC_ALL'):
        return  # overrides LC_TIME anyway
    system = (os.environ.get('LC_TIME') or os.environ.get('LANG')
              or '').split('.')[0]
    if language in (system, system.split('_')[0]):
        return
    candidates = [locale.normalize(language).split('.')[0] + '.UTF-8']
    if language == 'en':
        candidates.append('C.UTF-8')
    previous = locale.setlocale(locale.LC_TIME)
    for candidate in candidates:
        try:
            locale.setlocale(locale.LC_TIME, candidate)
        except locale.Error:
            continue
        os.environ['LC_TIME'] = candidate
        break
    locale.setlocale(locale.LC_TIME, previous)


if __name__ == '__main__':
    import gi

    from gi.repository import Gio

    # An uninstalled build has no pkgdatadir yet; fall back to the
    # gresource meson just generated so dev runs never load a stale
    # installed copy.
    bundle = os.path.join(pkgdatadir, 'babble.gresource')
    if not os.path.exists(bundle):
        bundle = os.path.join(
            os.path.dirname(os.path.abspath(__file__)), 'babble.gresource')
    resource = Gio.Resource.load(bundle)
    resource._register()

    # Babble's own language preference overrides the session's. It has
    # to be in place before the first lookup: modules translate at import
    # time and i18n.py caches the catalogue for the life of the process.
    schemas = Gio.SettingsSchemaSource.get_default()
    if schemas is not None and schemas.lookup(
            'io.github.mauriciobc.Babble', True) is not None:
        language = Gio.Settings.new('io.github.mauriciobc.Babble').get_string(
            'interface-language')
        if language:
            os.environ['LANGUAGE'] = language
            use_time_locale(language)

    from babble import main
    sys.exit(main.main(VERSION))
