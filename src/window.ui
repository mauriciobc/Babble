<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<interface>
  <requires lib="gtk" version="4.24"/>
  <requires lib="libadwaita" version="1.10"/>
  <template class="BabbleWindow" parent="AdwApplicationWindow">
    <property name="title" translatable="yes">Babble</property>
    <property name="default-width">800</property>
    <property name="default-height">600</property>
    <property name="width-request">360</property>
    <property name="height-request">294</property>
    <child>
      <!-- The compact layout is the default and the breakpoint widens it:
           AdwSidebar page mode must be set before the first map, otherwise
           libadwaita 1.10's scroll-restore idle spins the main loop. -->
      <object class="AdwBreakpoint">
        <condition>min-width: 601sp</condition>
        <setter object="split_view" property="collapsed">False</setter>
        <setter object="sidebar_list" property="mode">sidebar</setter>
        <setter object="home_compose_button" property="visible">False</setter>
        <setter object="notifications_bell" property="visible">False</setter>
      </object>
    </child>
    <property name="content">
      <object class="AdwToastOverlay" id="toast_overlay">
        <property name="child">
          <object class="GtkStack" id="main_stack">
            <property name="transition-type">crossfade</property>
            <child>
              <object class="GtkStackPage">
                <property name="name">login</property>
                <property name="child">
                  <object class="AdwToolbarView">
                    <child type="top">
                      <object class="AdwHeaderBar">
                        <child type="start">
                          <object class="GtkButton" id="login_back_button">
                            <property name="visible">False</property>
                            <property name="icon-name">go-previous-symbolic</property>
                            <property name="tooltip-text" translatable="yes">Back to Your Account</property>
                            <signal name="clicked" handler="on_login_back_clicked" swapped="no"/>
                            <accessibility>
                              <property name="label" translatable="yes">Back to Your Account</property>
                            </accessibility>
                          </object>
                        </child>
                        <property name="show-title">False</property>
                        <child type="end">
                          <object class="GtkMenuButton" id="login_menu_button">
                            <property name="primary">True</property>
                            <property name="icon-name">open-menu-symbolic</property>
                            <property name="tooltip-text" translatable="yes">Main Menu</property>
                            <property name="menu-model">login_menu</property>
                            <accessibility>
                              <property name="label" translatable="yes">Main Menu</property>
                            </accessibility>
                          </object>
                        </child>
                      </object>
                    </child>
                    <property name="content">
                      <object class="GtkScrolledWindow">
                        <property name="hscrollbar-policy">never</property>
                        <property name="child">
                          <object class="AdwClamp">
                            <property name="maximum-size">400</property>
                            <property name="tightening-threshold">300</property>
                            <property name="child">
                              <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <property name="valign">center</property>
                                <property name="spacing">24</property>
                                <property name="margin-top">24</property>
                                <property name="margin-bottom">24</property>
                                <property name="margin-start">12</property>
                                <property name="margin-end">12</property>
                                <child>
                                  <object class="GtkBox">
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">12</property>
                                    <child>
                                      <object class="GtkImage">
                                        <property name="icon-name">io.github.mauriciobc.Babble</property>
                                        <property name="pixel-size">128</property>
                                        <property name="accessible-role">presentation</property>
                                        <style>
                                          <class name="icon-dropshadow"/>
                                        </style>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel">
                                        <property name="label" translatable="yes">Welcome to Babble</property>
                                        <property name="wrap">True</property>
                                        <property name="justify">center</property>
                                        <property name="accessible-role">heading</property>
                                        <style>
                                          <class name="title-1"/>
                                        </style>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel">
                                        <property name="label" translatable="yes">Log in with your Mastodon account</property>
                                        <property name="wrap">True</property>
                                        <property name="justify">center</property>
                                        <style>
                                          <class name="body"/>
                                        </style>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox">
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">12</property>
                                    <child>
                                      <object class="GtkListBox">
                                        <property name="selection-mode">none</property>
                                        <style>
                                          <class name="boxed-list"/>
                                        </style>
                                        <child>
                                          <object class="AdwEntryRow" id="instance_entry">
                                            <property name="title" translatable="yes">_Server Address</property>
                                            <property name="use-underline">True</property>
                                            <property name="input-purpose">url</property>
                                            <property name="input-hints">no-spellcheck</property>
                                            <signal name="changed" handler="on_instance_changed" swapped="no"/>
                                            <signal name="entry-activated" handler="on_login_clicked" swapped="no"/>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="AdwPasswordEntryRow" id="code_entry">
                                            <property name="title" translatable="yes">_Authorization Code</property>
                                            <property name="use-underline">True</property>
                                            <property name="visible">False</property>
                                            <signal name="entry-activated" handler="on_code_entered" swapped="no"/>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel" id="instance_hint">
                                        <property name="label" translatable="yes">For example, mastodon.social</property>
                                        <property name="wrap">True</property>
                                        <property name="justify">center</property>
                                        <style>
                                          <class name="caption"/>
                                          <class name="dimmed"/>
                                        </style>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkBox" id="suggestions_section">
                                        <property name="orientation">vertical</property>
                                        <property name="spacing">6</property>
                                        <property name="visible">False</property>
                                        <child>
                                          <object class="GtkLabel" id="suggestions_label">
                                            <property name="label" translatable="yes">Other Popular Servers</property>
                                            <property name="accessible-role">heading</property>
                                            <style>
                                              <class name="caption-heading"/>
                                              <class name="dimmed"/>
                                            </style>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="AdwWrapBox" id="suggestions_box">
                                            <property name="align">0.5</property>
                                            <property name="child-spacing">6</property>
                                            <property name="line-spacing">6</property>
                                            <accessibility>
                                              <relation name="labelled-by">suggestions_label</relation>
                                            </accessibility>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox">
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">12</property>
                                    <property name="halign">center</property>
                                    <child>
                                      <object class="GtkButton" id="login_button">
                                        <property name="sensitive">False</property>
                                        <signal name="clicked" handler="on_login_clicked" swapped="no"/>
                                        <property name="child">
                                          <object class="GtkBox">
                                            <property name="spacing">6</property>
                                            <property name="halign">center</property>
                                            <child>
                                              <object class="AdwSpinner" id="login_spinner">
                                                <property name="visible">False</property>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkLabel" id="login_button_label">
                                                <property name="label" translatable="yes">_Continue</property>
                                                <property name="use-underline">True</property>
                                                <property name="mnemonic-widget">login_button</property>
                                                <property name="ellipsize">middle</property>
                                              </object>
                                            </child>
                                          </object>
                                        </property>
                                        <style>
                                          <class name="pill"/>
                                          <class name="suggested-action"/>
                                        </style>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkButton" id="cancel_login_button">
                                        <property name="label" translatable="yes">C_ancel</property>
                                        <property name="use-underline">True</property>
                                        <property name="visible">False</property>
                                        <signal name="clicked" handler="on_cancel_login_clicked" swapped="no"/>
                                        <style>
                                          <class name="pill"/>
                                        </style>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkButton" id="paste_code_button">
                                        <property name="label" translatable="yes">_Enter Authorization Code…</property>
                                        <property name="use-underline">True</property>
                                        <property name="visible">False</property>
                                        <signal name="clicked" handler="on_paste_code_clicked" swapped="no"/>
                                        <style>
                                          <class name="flat"/>
                                        </style>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLinkButton" id="sign_up_link">
                                        <property name="label" translatable="yes">C_reate an Account</property>
                                        <property name="use-underline">True</property>
                                        <property name="uri">https://joinmastodon.org/servers</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Credentials are stored in the system keyring</property>
                                    <property name="wrap">True</property>
                                    <property name="justify">center</property>
                                    <style>
                                      <class name="caption"/>
                                      <class name="dimmed"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </property>
                          </object>
                        </property>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkStackPage">
                <property name="name">shell</property>
                <property name="child">
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <child>
                      <object class="AdwBanner" id="draft_banner">
                        <property name="revealed">False</property>
                        <property name="button-label" translatable="yes">Restore</property>
                        <signal name="button-clicked" handler="on_draft_restore" swapped="no"/>
                      </object>
                    </child>
                    <child>
                      <object class="AdwNavigationSplitView" id="split_view">
                    <property name="collapsed">True</property>
                    <property name="sidebar">
                      <object class="AdwNavigationPage">
                        <property name="title" translatable="yes">Babble</property>
                        <property name="tag">sidebar</property>
                        <property name="child">
                          <object class="AdwToolbarView">
                            <child type="top">
                              <object class="AdwHeaderBar">
                                <child type="start">
                                  <object class="GtkButton">
                                    <property name="icon-name">document-edit-symbolic</property>
                                    <property name="action-name">win.compose</property>
                                    <property name="tooltip-text" translatable="yes">New Post</property>
                                    <accessibility>
                                      <property name="label" translatable="yes">New Post</property>
                                    </accessibility>
                                  </object>
                                </child>
                                <child type="end">
                                  <object class="GtkMenuButton" id="primary_menu_button">
                                    <property name="primary">True</property>
                                    <property name="icon-name">open-menu-symbolic</property>
                                    <property name="tooltip-text" translatable="yes">Main Menu</property>
                                    <property name="menu-model">primary_menu</property>
                                    <accessibility>
                                      <property name="label" translatable="yes">Main Menu</property>
                                    </accessibility>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <property name="content">
                              <object class="AdwSidebar" id="sidebar_list">
                                <property name="mode">page</property>
                                <signal name="activated" handler="on_sidebar_activated" swapped="no"/>
                                <property name="prefix">
                                  <object class="GtkMenuButton" id="account_button">
                                    <property name="tooltip-text" translatable="yes">Switch Account</property>
                                    <property name="margin-start">6</property>
                                    <property name="margin-end">6</property>
                                    <property name="margin-top">6</property>
                                    <property name="margin-bottom">6</property>
                                    <property name="child">
                                      <object class="GtkBox">
                                        <property name="spacing">12</property>
                                        <child>
                                          <object class="AdwAvatar" id="account_avatar">
                                            <property name="size">36</property>
                                            <property name="show-initials">True</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkBox">
                                            <property name="orientation">vertical</property>
                                            <property name="valign">center</property>
                                            <property name="hexpand">True</property>
                                            <child>
                                              <object class="GtkLabel" id="account_name_label">
                                                <property name="xalign">0</property>
                                                <property name="ellipsize">end</property>
                                                <style>
                                                  <class name="heading"/>
                                                </style>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkLabel" id="account_handle_label">
                                                <property name="xalign">0</property>
                                                <property name="ellipsize">end</property>
                                                <style>
                                                  <class name="caption"/>
                                                  <class name="dimmed"/>
                                                </style>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkImage">
                                            <property name="icon-name">pan-down-symbolic</property>
                                            <property name="accessible-role">presentation</property>
                                          </object>
                                        </child>
                                      </object>
                                    </property>
                                    <style>
                                      <class name="flat"/>
                                    </style>
                                  </object>
                                </property>
                              </object>
                            </property>
                          </object>
                        </property>
                      </object>
                    </property>
                    <property name="content">
                      <object class="AdwNavigationPage" id="content_page">
                        <property name="title" translatable="yes">Home</property>
                        <property name="tag">content</property>
                        <property name="child">
                          <object class="AdwNavigationView" id="navigation_view">
                            <child>
                              <object class="AdwNavigationPage" id="page_home">
                                <property name="title" translatable="yes">Home</property>
                                <property name="tag">home</property>
                                <property name="child">
                                  <object class="AdwToolbarView">
                                    <child type="top">
                                      <object class="AdwHeaderBar">
                                        <child type="start">
                                          <object class="GtkButton" id="home_compose_button">
                                            <property name="icon-name">document-edit-symbolic</property>
                                            <property name="action-name">win.compose</property>
                                            <property name="tooltip-text" translatable="yes">New Post</property>
                                            <accessibility>
                                              <property name="label" translatable="yes">New Post</property>
                                            </accessibility>
                                          </object>
                                        </child>
                                        <child type="end">
                                          <object class="GtkButton" id="notifications_bell">
                                            <property name="icon-name">babble-notifications-symbolic</property>
                                            <property name="action-name">win.show-notifications</property>
                                            <property name="tooltip-text" translatable="yes">Notifications</property>
                                            <accessibility>
                                              <property name="label" translatable="yes">Notifications</property>
                                            </accessibility>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <property name="content">
                                      <object class="AdwBin" id="home_bin"/>
                                    </property>
                                  </object>
                                </property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwNavigationPage" id="page_notifications">
                                <property name="title" translatable="yes">Notifications</property>
                                <property name="tag">notifications</property>
                                <property name="child">
                                  <object class="AdwToolbarView">
                                    <child type="top">
                                      <object class="AdwHeaderBar">
                                        <child type="end">
                                          <object class="GtkBox" id="notifications_header_slot">
                                            <property name="spacing">6</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <property name="content">
                                      <object class="AdwBin" id="notifications_bin"/>
                                    </property>
                                  </object>
                                </property>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </property>
                  </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </template>
  <!-- New Post and Refresh are absent on purpose: both have headerbar
       buttons and accelerators (Ctrl+N, Ctrl+R and F5), and Quit is
       reachable through Ctrl+Q and the app icon menu, so the primary
       menu keeps only items with no other front door. -->
  <menu id="primary_menu">
    <section>
      <item>
        <attribute name="label" translatable="yes">_Open Profile</attribute>
        <attribute name="action">win.view-profile</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">A_nnouncements</attribute>
        <attribute name="action">win.announcements</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Follow Requests</attribute>
        <attribute name="action">win.follow-requests</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Mutes &amp; Blocks</attribute>
        <attribute name="action">win.mutes-blocks</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">D_raft Posts</attribute>
        <attribute name="action">win.drafts</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Scheduled Posts</attribute>
        <attribute name="action">win.scheduled</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">_Collections</attribute>
        <attribute name="action">win.collections</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">#Fedi_Wrapped</attribute>
        <attribute name="action">win.wrapped</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Admin _Dashboard</attribute>
        <attribute name="action">win.admin</attribute>
        <attribute name="hidden-when">action-disabled</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">_Preferences</attribute>
        <attribute name="action">app.preferences</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Keyboard Shortcuts</attribute>
        <attribute name="action">app.shortcuts</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_About Babble</attribute>
        <attribute name="action">app.about</attribute>
      </item>
    </section>
  </menu>
  <menu id="login_menu">
    <section>
      <item>
        <attribute name="label" translatable="yes">_Preferences</attribute>
        <attribute name="action">app.preferences</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Keyboard Shortcuts</attribute>
        <attribute name="action">app.shortcuts</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_About Babble</attribute>
        <attribute name="action">app.about</attribute>
      </item>
    </section>
  </menu>
</interface>
