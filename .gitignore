.reference/

# Gauntlet evidence: rendered screenshots and bar references
evidence/

# Profiling captures from a running instance. Local evidence, never
# committed: the .syscap alone is hundreds of megabytes.
babble.perf.data
babble.perf.data.old
babble.syscap

# Agent and harness tooling, not project sources; keep them out of commits.
.agents/
.claude/
.commandcode/
.hermes/
.kiro/
skills/
skills-lock.json

# Research notes and reports, not project sources
/reports/
/research_notes/
