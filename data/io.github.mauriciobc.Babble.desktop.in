[Desktop Entry]
Name=Babble
Comment=Follow your Mastodon timelines
Exec=babble %u
MimeType=x-scheme-handler/babble;
Icon=io.github.mauriciobc.Babble
Terminal=false
Type=Application
Categories=Network;Chat;
