[Desktop Entry]
Name=Babble
Comment=Follow your Mastodon timelines
Exec=babble %U
MimeType=x-scheme-handler/babble;image/png;image/jpeg;image/gif;image/webp;image/avif;video/mp4;video/webm;video/quicktime;
Icon=io.github.mauriciobc.Babble
Terminal=false
Type=Application
Categories=Network;Chat;
# Translators: Search terms to find this application. Do NOT translate or localize the semicolons. The list MUST also end with a semicolon.
Keywords=Mastodon;Fediverse;Social;Toot;Post;
StartupNotify=true
DBusActivatable=true
# The action ids are the application actions D-Bus activation runs.
Actions=compose;show-notifications;

[Desktop Action compose]
Name=New Post
Exec=babble

[Desktop Action show-notifications]
Name=Notifications
Exec=babble
