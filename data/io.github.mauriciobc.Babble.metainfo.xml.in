<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.mauriciobc.Babble</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Babble</name>
  <summary>Follow your Mastodon timelines</summary>
  <developer id="io.github.mauriciobc">
    <name>mauriciobc</name>
  </developer>
  <description>
    <p>Babble is a Mastodon client focused on reading and writing posts. Follow your home timeline, catch up on notifications, read whole threads and write posts without leaving the desktop.</p>
    <ul>
      <li>Home, Local, Federated and Explore timelines</li>
      <li>Notifications with mentions filter</li>
      <li>Threads and profiles</li>
      <li>Posts with media, content warnings and polls</li>
    </ul>
  </description>
  <url type="homepage">https://github.com/mauriciobc/Babble</url>
  <url type="bugtracker">https://github.com/mauriciobc/Babble/issues</url>
  <url type="vcs-browser">https://github.com/mauriciobc/Babble</url>
  <url type="contribute">https://github.com/mauriciobc/Babble/graphs/contributors</url>
  <url type="translate">https://github.com/mauriciobc/Babble/blob/main/Docs/localization.md</url>
  <launchable type="desktop-id">io.github.mauriciobc.Babble.desktop</launchable>
  <update_contact>mauriciobc_AT_github.com</update_contact>
  <content_rating type="oars-1.1">
    <content_attribute id="social-chat">intense</content_attribute>
    <content_attribute id="social-info">mild</content_attribute>
  </content_rating>
  <screenshots>
    <screenshot type="default">
      <image type="source">https://raw.githubusercontent.com/mauriciobc/Babble/8c3e835025112cbd199e81e96110632a49531b1e/data/screenshots/timeline.png</image>
      <caption>Home timeline with posts, media and the action bar</caption>
    </screenshot>
    <screenshot>
      <image type="source">https://raw.githubusercontent.com/mauriciobc/Babble/8c3e835025112cbd199e81e96110632a49531b1e/data/screenshots/catch-up.png</image>
      <caption>Catch Up: the posts you missed over a window you choose, ranked as a grid</caption>
    </screenshot>
    <screenshot>
      <image type="source">https://raw.githubusercontent.com/mauriciobc/Babble/8c3e835025112cbd199e81e96110632a49531b1e/data/screenshots/hashtag.png</image>
      <caption>A hashtag timeline, with a quoted post</caption>
    </screenshot>
    <screenshot>
      <image type="source">https://raw.githubusercontent.com/mauriciobc/Babble/8c3e835025112cbd199e81e96110632a49531b1e/data/screenshots/composer.png</image>
      <caption>Writing a post, with a poll and the language picker</caption>
    </screenshot>
  </screenshots>
  <branding>
    <color type="primary" scheme_preference="light">#04c7f0</color>
    <color type="primary" scheme_preference="dark">#0799ed</color>
  </branding>
  <requires>
    <display_length>360</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>
  <translation type="gettext">babble</translation>
  <releases>
    <release version="0.3.0" date="2026-11-01">
      <description>
        <p>
          Babble can now be extended with plugins, turned on from a new
          Plugins page. Two ship with it: Wallabag, to save a post's link
          for later, and Hashpanel, for the daily hashtags of the
          Brazilian fediverse.
        </p>
        <p>
          The composer suggests hashtags as you type, and can schedule a
          new post. Home reopens at the post you were reading.
        </p>
        <p>Other changes:</p>
        <ul>
          <li>Deleting a post and removing a boost can be undone.</li>
          <li>A single notification can be dismissed.</li>
          <li>Boosts can be hidden on Home, and Home filters apply at once.</li>
          <li>Editing a scheduled post keeps its poll, duration and language.</li>
          <li>Removing an account also removes its saved credentials.</li>
          <li>A missing keyring is reported clearly instead of failing quietly.</li>
        </ul>
      </description>
    </release>
    <release version="0.2.0" date="2026-10-16">
      <description>
        <p>
          Babble now has a Help menu item and a F1 shortcut that open the
          help pages shipped with the app, falling back to the online
          documentation when no help viewer can see them.
        </p>
        <p>
          Preferences can be searched, and opening them again brings the
          dialog you already have up instead of a second copy.
        </p>
        <p>Other changes:</p>
        <ul>
          <li>The attachment viewer no longer overflows a narrow window.</li>
          <li>Text size and line height now apply to every kind of text, not just labels.</li>
          <li>Charts and buttons stay readable in high contrast.</li>
          <li>The Catch-Up chart and filter controls are announced by screen readers.</li>
          <li>One emphasised button per view in the list, hashtag and report editors.</li>
          <li>US spelling, and spelled-out examples in place of Latin abbreviations, in the interface text.</li>
        </ul>
        <p>
          Translations: nothing already translated was lost. This release
          adds 35 strings to the template — chiefly the GSettings
          summaries, which had never reached a translator — and re-words
          about 55 menu labels that gained an access key, a mnemonic being
          part of the string. The new and re-worded entries show in
          English until a translator gets to them.
        </p>
      </description>
    </release>
    <release version="0.1.0" date="2026-10-10">
      <description>
        <p>Initial public release.</p>
      </description>
    </release>
  </releases>
</component>
