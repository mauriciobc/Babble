#: data/io.github.mauriciobc.Babble.metainfo.xml.in:6 src/window.ui:7
msgid "Babble"
msgstr "Babble"

#: data/io.github.mauriciobc.Babble.desktop.in:3
#: data/io.github.mauriciobc.Babble.metainfo.xml.in:7
msgid "Follow your Mastodon timelines"
msgstr "Sigue tus cronologías de Mastodon"

#. Translators: Search terms to find this application. Do NOT translate or localize the semicolons. The list MUST also end with a semicolon.
#: data/io.github.mauriciobc.Babble.desktop.in:11
msgid "Mastodon;Fediverse;Social;Toot;Post;"
msgstr "Mastodon;Fediverso;Social;Toot;Publicación;Red social;"

