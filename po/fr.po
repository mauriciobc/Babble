msgid "You are not on Na Real yet. Sign in from My Questions first."
msgstr ""
"Vous n’êtes pas encore sur Na Real. Connectez-vous d’abord depuis Mes "
"Questions."

#: plugins/nareal/babble_nareal.py:405
msgid "Anonymous questions for the fediverse"
msgstr "Des questions anonymes pour le fédivers"

#: plugins/nareal/babble_nareal.py:408
msgid "Open Na Real"
msgstr "Ouvrir Na Real"

#: plugins/nareal/babble_nareal.py:438
msgid ""
"Na Real is run by each community on its own server. Enter the address of the "
"one you use."
msgstr ""
"Na Real est géré par chaque communauté sur son propre serveur. Saisissez "
"l’adresse de celui que vous utilisez."

#: plugins/nareal/babble_nareal.py:448
msgid ""
"Added to the invitation you share from the main menu, and the hashtag that "
"shows the Na Real banner."
msgstr ""
"Ajouté à l’invitation que vous partagez depuis le menu principal, et au mot-"
"clic qui affiche la bannière Na Real."

#: plugins/nareal/babble_nareal.py:474
msgid "That is your own server. Use the address of a Na Real server."
msgstr "C’est votre propre serveur. Utilisez l’adresse d’un serveur Na Real."

#: plugins/nareal/babble_nareal.py:485
msgid "Na Real server saved"
msgstr "Serveur Na Real enregistré"

#: plugins/nareal/babble_nareal.py:491
msgid "Use a single hashtag, without spaces"
msgstr "Utilisez un seul mot-clic, sans espaces"

#: plugins/nareal/babble_nareal.py:501
msgid "Na Real hashtag saved"
msgstr "Mot-clic Na Real enregistré"

#: plugins/wallabag/babble_wallabag.py:172
#: plugins/wallabag/babble_wallabag.py:204
#: plugins/wallabag/babble_wallabag.py:224
msgid "Wait for the current Wallabag request to finish."
msgstr "Attendez la fin de la demande Wallabag en cours."

#. Translators: %s is the system keyring failure.
#: plugins/wallabag/babble_wallabag.py:212
#, python-format
msgid "Could not remove Wallabag credentials: %s"
msgstr "Impossible de supprimer les identifiants Wallabag : %s"

#: plugins/wallabag/babble_wallabag.py:240
msgid "The server did not accept these details"
msgstr "Le serveur n’a pas accepté ces informations"

#: plugins/wallabag/babble_wallabag.py:242
msgid "No Wallabag server answered at this address"
msgstr "Aucun serveur Wallabag n’a répondu à cette adresse"

#: plugins/wallabag/babble_wallabag.py:246
msgid "The server sent no token"
msgstr "Le serveur n’a envoyé aucun jeton"

#. Translators: %s is the system keyring failure.
#: plugins/wallabag/babble_wallabag.py:265
#, python-format
msgid "Could not save Wallabag credentials: %s"
msgstr "Impossible d’enregistrer les identifiants Wallabag : %s"

#: plugins/wallabag/babble_wallabag.py:292
msgid "Save to _Wallabag"
msgstr "Enregistrer sur _Wallabag"

#: plugins/wallabag/babble_wallabag.py:294
msgid "Save to _Wallabag…"
msgstr "Enregistrer sur _Wallabag…"

#: plugins/wallabag/babble_wallabag.py:307
msgid "Saved to Wallabag"
msgstr "Enregistré sur Wallabag"

#. Translators: %s is the reason, as the server or the
#. network gave it.
#: plugins/wallabag/babble_wallabag.py:311
#, python-format
msgid "Could not save to Wallabag: %s"
msgstr "Impossible d’enregistrer sur Wallabag : %s"

#: plugins/wallabag/babble_wallabag.py:329
msgid "Account"
msgstr "Compte"

#: plugins/wallabag/babble_wallabag.py:333
msgid "Saved posts go to this account"
msgstr "Les messages enregistrés vont sur ce compte"

#. Translators: a Wallabag account, by its username and the
#. server's host name.
#: plugins/wallabag/babble_wallabag.py:345
#, python-format
msgid "%(username)s on %(server)s"
msgstr "%(username)s sur %(server)s"

#: plugins/wallabag/babble_wallabag.py:347
msgid "Sign _Out"
msgstr "Se _déconnecter"

#: plugins/wallabag/babble_wallabag.py:350
msgid "Not signed in"
msgstr "Non connecté"

#: plugins/wallabag/babble_wallabag.py:351
msgid "_Sign In…"
msgstr "_Se connecter…"

#: plugins/wallabag/babble_wallabag.py:367
msgid "Signed out of Wallabag"
msgstr "Déconnecté de Wallabag"

#: plugins/wallabag/babble_wallabag.py:378
msgid "Sign In to Wallabag"
msgstr "Se connecter à Wallabag"

#: plugins/wallabag/babble_wallabag.py:386
msgid "_Sign In"
msgstr "_Se connecter"

#: plugins/wallabag/babble_wallabag.py:394
msgid "app.wallabag.it, or your own server’s address"
msgstr "app.wallabag.it, ou l’adresse de votre propre serveur"

#: plugins/wallabag/babble_wallabag.py:395
msgid "Client ID"
msgstr "ID client"

#: plugins/wallabag/babble_wallabag.py:397
msgid "Client Secret"
msgstr "Secret client"

#: plugins/wallabag/babble_wallabag.py:400
msgid "Password"
msgstr "Mot de passe"

#: plugins/wallabag/babble_wallabag.py:402
msgid ""
"Use app.wallabag.it for the hosted service. Create a client under API "
"Clients Management in Wallabag to get its ID and secret."
msgstr ""
"Utilisez app.wallabag.it pour le service hébergé. Créez un client dans "
"Gestion des clients API dans Wallabag pour obtenir son ID et son secret."

#: plugins/wallabag/babble_wallabag.py:408
msgid "Your password is used once to sign in and is not stored"
msgstr ""
"Votre mot de passe sert une fois à vous connecter et n’est pas enregistré"
