msgid "Threads and profiles"
msgstr "Unterhaltungen und Profile"

#: data/io.github.mauriciobc.Babble.metainfo.xml.in:17
msgid "Posts with media, content warnings and polls"
msgstr "Beiträge mit Medien, Inhaltswarnungen und Umfragen"

#: data/io.github.mauriciobc.Babble.metainfo.xml.in:33
