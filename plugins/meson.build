# The plugins Babble ships, installed beside the package
# (pkgdatadir/plugins), which is where pluginhost.search_paths() looks
# for them; uninstalled, it finds this directory instead. They are off
# until the user enables them.
install_data(
  'wallabag/babble_wallabag.plugin',
  'wallabag/babble_wallabag.py',
  install_dir: pkgdatadir / 'plugins' / 'wallabag',
)

install_data(
  'hashpanel/babble_hashpanel.plugin',
  'hashpanel/babble_hashpanel.py',
  install_dir: pkgdatadir / 'plugins' / 'hashpanel',
)
